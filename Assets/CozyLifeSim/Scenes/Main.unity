  _npcData:
    NpcName: "B\xE0 Ngo\u1EA1i"
    Dialogues:
    - Line: "Qu\xEA m\xECnh \u0111\u1EB9p l\u1EAFm con \u01A1i, l\xFAa ch\xEDn v\xE0ng
        \u0111\u1ED3ng, ng\u1ECDt l\u1ECBm h\u01B0\u01A1ng m\xEDa n\u1ED3ng n\xE0n."
    - Line: "H\xE3y ch\u0103m ch\u1EC9 t\u01B0\u1EDBi n\u01B0\u1EDBc cho m\xEDa ng\u1ECDt
        nh\xE9, b\xF4ng l\xFAa n\u01B0\u1EDBc ngo\xE0i kia c\u0169ng \u0111ang l\u1EDBn
        d\u1EA7n k\xECa."
    - Line: "C\u1EA3m nh\u1EADn t\u1EEBng l\xE0n gi\xF3 \u1EA5m \xE1p c\u1EE7a l\xE0ng
        qu\xEA, m\u1ECDi th\u1EE9 th\u1EADt \xEAm \u0111\u1EC1m ph\u1EA3i kh\xF4ng
        con?"
    Portrait: {fileID: 7580644696832731750, guid: 1a0ac4cf6871e314db1858705020312c, type: 3}
