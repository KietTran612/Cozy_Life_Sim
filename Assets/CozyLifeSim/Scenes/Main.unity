  m_Script: {fileID: 11500000, guid: b705b32f96b350d47a90f4874d4b53b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: CozyLifeSim.UI::CozyLifeSim.UI.CozyDialoguePopup
  _contentPanel: {fileID: 211967287}
  _portrait: {fileID: 2036420163}
  _nameText: {fileID: 1065303659}
  _dialogueText: {fileID: 264923375}
  _nextButton: {fileID: 1478861430}
  _dialogueIndicator: {fileID: 362066496}
  _questDialogues:
  - QuestId: 2
    NpcName: "B\xE0 Ngo\u1EA1i"
    DialogueText: "Con y\xEAu, c\xE2y m\xEDa ng\u1ECDt n\xE0y ch\xEDnh l\xE0 h\u01B0\u01A1ng
      v\u1ECB m\xF9a h\xE8 \u1EDF qu\xEA m\xECnh \u0111\u1EA5y. Ng\xE0y x\u01B0a
      m\u1ED7i l\u1EA7n tr\u1EDDi n\u1EAFng n\xF3ng, b\xE0 l\u1EA1i \xE9p n\u01B0\u1EDBc
      m\xEDa cho m\u1EB9 con u\u1ED1ng."
    Portrait: {fileID: 7580644696832731750, guid: 1a0ac4cf6871e314db1858705020312c, type: 3}
  - QuestId: 3
    NpcName: "B\xE0 Ngo\u1EA1i"
    DialogueText: "H\u1EA1t g\u1EA1o v\xE0ng t\u1EEB b\xF4ng l\xFAa n\u01B0\u1EDBc
      n\xE0y l\xE0m n\xEAn b\xE1nh ch\u01B0ng, b\xE1nh d\xE0y th\u01A1m d\u1EBBo
      m\u1ED7i d\u1ECBp T\u1EBFt. Gi\u1EEF l\u1EA5y h\u1EA1t g\u1EA1o l\xE0 gi\u1EEF
      l\u1EA5y h\u1ED3n qu\xEA h\u01B0\u01A1ng, con nh\xE9."
    Portrait: {fileID: 7580644696832731750, guid: 1a0ac4cf6871e314db1858705020312c, type: 3}
  - QuestId: 4
    NpcName: "B\xE0 Ngo\u1EA1i"
    DialogueText: "Ch\xFA m\xE8o tam th\u1EC3 n\xE0y ngoan l\u1EAFm. \u0110\u1ED9ng
      v\u1EADt \u1EDF qu\xEA m\xECnh lu\xF4n hi\u1EC1n l\xE0nh v\xE0 \u1EA5m \xE1p
      nh\u01B0 th\u1EBF, h\xE3y lu\xF4n y\xEAu th\u01B0\u01A1ng ch\xFAng nh\xE9 con."
    Portrait: {fileID: 7580644696832731750, guid: 1a0ac4cf6871e314db1858705020312c, type: 3}
